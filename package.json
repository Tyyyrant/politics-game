{
  "name": "politics-game",
  "version": "0.9.0",
  "description": "政治模拟：派系斗争",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.politics.game",
    "productName": "政治模拟：派系斗争",
    "files": [
      "electron/**/*",
      "src/**/*",
      "index.html",
      "portraits/**/*"
    ],
    "mac": { "target": "dmg", "icon": "icon.png" },
    "win": { "target": "portable", "icon": "icon.png" }
  },
  "devDependencies": {
    "electron": "^27.3.11",
    "electron-builder": "^26.15.3"
  }
}
